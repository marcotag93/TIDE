  - "transcranial magnetic stimulation"
  - "TMS"
  - "SimNIBS"
  - "tractography"
  - "diffusion MRI"
  - "activating function"
  - "electric field"
  - "dose estimation"
  - "neurostimulation"
  - "Python"
